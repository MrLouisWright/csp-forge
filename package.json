{
  "name": "csp-forge",
  "version": "1.1.1",
  "description": "Scan a built static site (dist/, build/, out/) or live URL and generate a tight Content-Security-Policy with sha256 hashes or nonce + strict-dynamic for SSR. Vite/webpack plugins, reporting headers, --check for CI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/plugins/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/plugins/vite.d.ts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/plugins/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/plugins/webpack.d.ts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "csp-forge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "csp",
    "content-security-policy",
    "security",
    "security-headers",
    "static-site",
    "vite",
    "webpack",
    "nonce",
    "strict-dynamic",
    "nginx",
    "netlify",
    "vercel",
    "helmet",
    "sha256",
    "hash",
    "ci",
    "cli",
    "sarif",
    "xss",
    "report-to",
    "report-uri"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/csp-forge.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/csp-forge/issues"
  },
  "homepage": "https://mrlouiswright.github.io/csp-forge/",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
